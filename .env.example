# ID Auto — environment variables (IDA-2C onward)
# Copy to .env and set real values. Never commit .env — see .gitignore.

# Database connection (IDA-2B's idauto-postgres instance, or wherever it is deployed)
IDAUTO_DB_HOST=127.0.0.1
IDAUTO_DB_PORT=5432
IDAUTO_DB_USER=idauto
IDAUTO_DB_PASSWORD=
IDAUTO_DB_NAME=idauto

# API server
IDAUTO_API_PORT=3001

# Minimal admin identity stub (IDA-2E-PRE) — NOT the real Mythos OS auth
# service integration (docs/ARCHITECTURE.md §4.1), which remains
# blocked — no such service exists anywhere in this codebase yet. This is
# a small, explicit, operator-provisioned map of bearer tokens to stable
# identity strings, so audit records can say WHO acted instead of just
# "some admin, unspecified". JSON object: { "<token>": "<identity>" }.
# Generate each token with: openssl rand -base64 32
IDAUTO_ADMIN_IDENTITIES={"REPLACE_WITH_GENERATED_TOKEN":"admin:REPLACE_WITH_NAME"}

# ---------------------------------------------------------------------------
# IDA-V12 (2026-09-05) — vehicle identification, catalogue, cache. ALL OPTIONAL.
# Leave every line below unset and IDauto runs with: local database → manual
# fallback, local parts catalogue, "Catalogue fournisseur non configuré".
# ---------------------------------------------------------------------------

# Resolution cache (in-process). Positive results, negative results, size.
IDAUTO_RESOLUTION_CACHE_TTL_SECONDS=300
IDAUTO_RESOLUTION_CACHE_NEGATIVE_TTL_SECONDS=60
IDAUTO_RESOLUTION_CACHE_MAX_ENTRIES=1000

# External plate/VIN → vehicle provider (docs/VEHICLE_RESOLUTION.md §3).
# A LICENSED provider with the operator's OWN credential only. URL template
# with {plate} (the search key, e.g. 8646TU230) or {vin}. https only.
# None is configured in any IDauto deployment as of 2026-09-05.
#IDAUTO_VEHICLE_PROVIDER_NAME=
#IDAUTO_VEHICLE_PROVIDER_URL=https://provider.example/lookup?plate={plate}
#IDAUTO_VEHICLE_PROVIDER_VIN_URL=https://provider.example/lookup?vin={vin}
#IDAUTO_VEHICLE_PROVIDER_TOKEN=
#IDAUTO_VEHICLE_PROVIDER_TIMEOUT_MS=4000

# TecDoc-style catalogue gateway (docs/TECDOC.md §3). Requires a TecAlliance
# licence; not configured anywhere as of 2026-09-05.
#IDAUTO_TECDOC_BASE_URL=https://gateway.example/tecdoc
#IDAUTO_TECDOC_API_KEY=
#IDAUTO_TECDOC_PROVIDER_ID=
#IDAUTO_TECDOC_PROVIDER_NAME=tecdoc
#IDAUTO_TECDOC_TIMEOUT_MS=5000

# Never set in production. Mock providers refuse to construct otherwise.
#IDAUTO_ALLOW_MOCK_PROVIDERS=0
