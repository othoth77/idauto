# ID Auto — environment variables (IDA-2C onward)
# Copy to .env and set real values. Never commit .env — see .gitignore.

# Database connection (IDA-2B's idauto-postgres instance, or wherever it is deployed)
IDAUTO_DB_HOST=127.0.0.1
IDAUTO_DB_PORT=5432
IDAUTO_DB_USER=idauto
IDAUTO_DB_PASSWORD=
IDAUTO_DB_NAME=idauto

# API server
IDAUTO_API_PORT=3001

# Minimal admin identity stub (IDA-2E-PRE) — NOT the real Mythos OS auth
# service integration (docs/ARCHITECTURE.md §4.1), which remains
# blocked — no such service exists anywhere in this codebase yet. This is
# a small, explicit, operator-provisioned map of bearer tokens to stable
# identity strings, so audit records can say WHO acted instead of just
# "some admin, unspecified". JSON object: { "<token>": "<identity>" }.
# Generate each token with: openssl rand -base64 32
IDAUTO_ADMIN_IDENTITIES={"REPLACE_WITH_GENERATED_TOKEN":"admin:REPLACE_WITH_NAME"}

# ---------------------------------------------------------------------------
# IDA-V12 (2026-09-05) — vehicle identification, catalogue, cache. ALL OPTIONAL.
# Leave every line below unset and IDauto runs with: local database → manual
# fallback, local parts catalogue, "Catalogue fournisseur non configuré".
# ---------------------------------------------------------------------------

# Resolution cache (in-process). Positive results, negative results, size.
IDAUTO_RESOLUTION_CACHE_TTL_SECONDS=300
IDAUTO_RESOLUTION_CACHE_NEGATIVE_TTL_SECONDS=60
IDAUTO_RESOLUTION_CACHE_MAX_ENTRIES=1000

# External plate/VIN → vehicle provider (docs/VEHICLE_RESOLUTION.md §3).
# A LICENSED provider with the operator's OWN credential only. URL template
# with {plate} (the search key, e.g. 8646TU230) or {vin}. https only.
# None is configured in any IDauto deployment as of 2026-09-05.
#IDAUTO_VEHICLE_PROVIDER_NAME=
#IDAUTO_VEHICLE_PROVIDER_URL=https://provider.example/lookup?plate={plate}
#IDAUTO_VEHICLE_PROVIDER_VIN_URL=https://provider.example/lookup?vin={vin}
#IDAUTO_VEHICLE_PROVIDER_TOKEN=
#IDAUTO_VEHICLE_PROVIDER_TIMEOUT_MS=4000

# TecDoc-style catalogue gateway (docs/TECDOC.md §3). Requires a TecAlliance
# licence; not configured anywhere as of 2026-09-05.
#IDAUTO_TECDOC_BASE_URL=https://gateway.example/tecdoc
#IDAUTO_TECDOC_API_KEY=
#IDAUTO_TECDOC_PROVIDER_ID=
#IDAUTO_TECDOC_PROVIDER_NAME=tecdoc
#IDAUTO_TECDOC_TIMEOUT_MS=5000

# Never set in production. Mock providers refuse to construct otherwise.
#IDAUTO_ALLOW_MOCK_PROVIDERS=0

# ---------------------------------------------------------------------------
# IDA-V13 (2026-09-05) — login / password + server-side sessions (Better Auth)
# ---------------------------------------------------------------------------
# Signs the session cookie. REQUIRED. 32+ random characters:
#   openssl rand -base64 32
# Rotating it signs every web user out.
IDAUTO_AUTH_SECRET=REPLACE_WITH_GENERATED_SECRET
# Public origin of the site (used for cookie/CSRF origin checks). Production: https://idauto.tn
IDAUTO_AUTH_BASE_URL=https://idauto.tn
# Secure cookie flag. Automatically on when NODE_ENV=production; force with 1.
IDAUTO_COOKIE_SECURE=1
# Session lifetime in seconds (default 43200 = 12 h; sliding renewal every hour of use).
IDAUTO_SESSION_TTL_SECONDS=43200
# Users are created by the operator: node ops/auth-users.js create --email … --name … --role admin
# (the password is typed without echo; never on the command line).
#
# IDAUTO_ADMIN_IDENTITIES above is now used ONLY for server-to-server
# organisation credentials (e.g. atelier.fixpert.tn). Web users sign in at /login.

# ---------------------------------------------------------------------------
# IDA-V14 (2026-09-05) — carte grise (registration document). ALL OPTIONAL.
# ---------------------------------------------------------------------------
# Where the image bytes live: 'local' = the private media root above
# (IDAUTO_MEDIA_STORAGE_PATH). Other adapters (S3-compatible) are not implemented.
IDAUTO_DOCUMENT_STORAGE=local
# Maximum accepted size of ONE optimised face image (bytes). The browser
# pipeline targets a few hundred KB; 6 MB is the hard ceiling.
IDAUTO_DOCUMENT_MAX_BYTES=6291456
# Uploads / OCR runs per user per 10 minutes.
IDAUTO_DOCUMENT_UPLOADS_PER_10MIN=60

# ---- Vehicle visual recognition (Update 2) — OFF unless all of this is set ----
# With nothing here, make / model / body type are « Non reconnu » and no photo leaves the server.
# To enable: put the three lines in the SERVER's environment file (mode 0600, readable by the service
# account only), never in this file, never in Git, never in anything served to the browser.
# The key is read by reference/recognition/vehicle-vision.js only. docs/VEHICLE_RECOGNITION.md §4.
# IDAUTO_VISION_PROVIDER=anthropic
# IDAUTO_VISION_API_KEY=
# IDAUTO_VISION_MODEL=claude-opus-5-5

# ---- Update 3.1 — scanner photographs ----
# Anonymous visitors may store photographs and save/attach vehicles only when this is 1 (legal gates L01/L02 first).
# IDAUTO_PUBLIC_SCAN_STORE=0
# Second copy of every photograph on Haddad (ops/haddad/README-idauto-media.md). Server environment only, mode 0600.
# IDAUTO_HADDAD_MEDIA_URL=https://<haddad tailnet name>/idauto-media
# IDAUTO_HADDAD_MEDIA_ADDR=<haddad tailnet address>
# IDAUTO_HADDAD_MEDIA_TOKEN=
