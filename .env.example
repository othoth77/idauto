# ID Auto — environment variables (IDA-2C onward)
# Copy to .env and set real values. Never commit .env — see .gitignore.

# Database connection (IDA-2B's idauto-postgres instance, or wherever it is deployed)
IDAUTO_DB_HOST=127.0.0.1
IDAUTO_DB_PORT=5432
IDAUTO_DB_USER=idauto
IDAUTO_DB_PASSWORD=
IDAUTO_DB_NAME=idauto

# API server
IDAUTO_API_PORT=3001

# Minimal admin identity stub (IDA-2E-PRE) — NOT the real Mythos OS auth
# service integration (docs/ARCHITECTURE.md §4.1), which remains
# blocked — no such service exists anywhere in this codebase yet. This is
# a small, explicit, operator-provisioned map of bearer tokens to stable
# identity strings, so audit records can say WHO acted instead of just
# "some admin, unspecified". JSON object: { "<token>": "<identity>" }.
# Generate each token with: openssl rand -base64 32
IDAUTO_ADMIN_IDENTITIES={"REPLACE_WITH_GENERATED_TOKEN":"admin:REPLACE_WITH_NAME"}
