    VPROV["Licensed vehicle-data provider adapter<br/>(plate / VIN lookup) NOT CONFIGURED"]
    WS["workspace/<br/>registration-service · intervention-service<br/>vehicle-details · owner-contacts · workspace-repository"]:::ext
    DOCS["documents/<br/>document-service · image-meta<br/>(registration-parser: retired OCR, 410)"]:::ext
    VEHM["vehicle/<br/>vehicle-resolver · plate-normalizer · vin"]:::ext
    PARTS["parts/<br/>parts-catalog · local-parts-catalog · tecdoc-adapter"]:::ext
    WSH["workshop/<br/>workshop-vehicle-service"]:::ext
    CORE["ingestion · passport-assembly · ivid-issuance<br/>public-surface-policy · rate-limit"]:::ext
    ADM["admin/admin-repository"]:::ext
    AUTHMOD["auth/auth.js (Better Auth) · auth/principal.js · identity.js · session.js"]:::ext
    API["API layer — one Node.js http server (reference/api.js createServer)"]:::ext
    WS --> REPO
    WS --> WRITES
    DOCS --> STO
