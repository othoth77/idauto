---
title: "Interventions, opérations, pièces et audit"
---
classDiagram
    direction LR
    class Intervention {
        <<entity>>
        +BIGSERIAL id PK
        +INTEGER org_id FK
        +INTEGER vehicle_id FK
        +VARCHAR status
        +VARCHAR reason
        +DATE performed_on
        +INTEGER odometer_km
        +VARCHAR technician_ref
    }
    class Operation {
        <<entity>>
        +BIGSERIAL id PK
        +BIGINT visit_id FK
        +VARCHAR operation_type
        +BIGINT part_id FK
        +VARCHAR part_label
        +VARCHAR part_reference_text
        +INTEGER quantity
        +PartSource part_source
        +VARCHAR status
    }
    class PartSource {
        <<enumeration>>
        our_shop
        customer_supplied
        external_supplier (legacy)
    }
    class CataloguePart {
        <<entity>>
        +BIGSERIAL id PK
        +VARCHAR reference
        +VARCHAR brand
        +VARCHAR name
        +INTEGER org_id FK
    }
    class AuditEntry {
        <<entity>>
        +BIGSERIAL id PK
        +VARCHAR event_type
        +VARCHAR actor_ref
        +INTEGER org_id
        +VARCHAR target_ref
    }
    class Vehicle
    class Organisation
    Vehicle "0..1" <-- "0..*" Intervention : vehicle_id
    Organisation "1" <-- "0..*" Intervention : org_id
    Intervention "1" *-- "0..*" Operation : visit_id
    CataloguePart "0..1" <-- "0..*" Operation : part_id
    Organisation "0..1" <-- "0..*" CataloguePart : org_id
    Operation ..> PartSource : part_source
